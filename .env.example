# Application Settings
APP_NAME="TicketDesk Enterprise"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Security & JWT
# Development falls back to built-in local defaults. For production, set
# APP_ENV=production, DEBUG=false, and inject a randomly generated key at runtime.
# SECRET_KEY=<generate-at-least-32-random-bytes>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ticketdesk
# POSTGRES_PASSWORD=<local-compose-password-override>
POSTGRES_DB=ticketdesk_db
# For a direct backend launch with custom DB settings, set DATABASE_URL explicitly.
# For production, inject the PostgreSQL URL at runtime with a unique password.
# DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<host>:5432/<database>

# CORS
# In production use exact HTTPS origins, or [] for a same-origin reverse proxy.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Storage Configuration (local | s3)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt

# AWS S3 Settings (Used when STORAGE_PROVIDER=s3; relies on IAM Role on EC2/ECS in production)
AWS_REGION=us-east-1
S3_BUCKET_NAME=ticketdesk-enterprise-attachments
S3_PRESIGNED_URL_EXPIRATION=3600

# Optional SMTP Settings
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ticketdesk.enterprise

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
